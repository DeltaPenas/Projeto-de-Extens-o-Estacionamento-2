generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carro {
  id        Int                       @id @default(autoincrement())
  placa     String                    @unique
  modelo    String
  cor       String
  registros RegistroEstacionamentos[]
}

model Vaga {
  id        Int                       @id @default(autoincrement())
  numero    Int                       @unique

  registros RegistroEstacionamentos[]
}

model RegistroEstacionamentos {
  id      Int       @id @default(autoincrement())
  entrada DateTime
  saida   DateTime?

  carro   Carro     @relation(fields:[carroId], references:[id])
  carroId Int
  vaga    Vaga      @relation(fields:[vagaId], references:[id])
  vagaId  Int
}